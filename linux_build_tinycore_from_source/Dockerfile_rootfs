FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    cpio \
    gzip \
    xz-utils \
    binutils \
    make \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# The Makefile will be provided at runtime via bind mount
CMD ["make", "-f", "Makefile_rootfs"]
