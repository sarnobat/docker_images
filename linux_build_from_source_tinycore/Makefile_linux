ARCH ?= x86_64
CROSS_COMPILE ?= x86_64-linux-gnu-
KERNEL_DIR ?= /out/linux-6.12.11
CONFIG_SRC ?= /build/config-6.12.11-tinycore64

config:
	echo "SRIDHAR"
	test -d "$(KERNEL_DIR)"
	cp "$(CONFIG_SRC)" "$(KERNEL_DIR)/.config"
	$(MAKE) -C "$(KERNEL_DIR)" ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) scripts
	cd "$(KERNEL_DIR)" && \
		scripts/config --disable X86_X32 && \
		scripts/config --disable IA32_EMULATION && \
		scripts/config --disable COMPAT && \
		scripts/config --disable X86_32 && \
		scripts/config --disable MITIGATION_RETPOLINE && \
		scripts/config --disable RETPOLINE && \
		yes "" | make ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) olddefconfig && \
		make ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) V=1 bzImage

bzImage:
	@echo "TODO"
